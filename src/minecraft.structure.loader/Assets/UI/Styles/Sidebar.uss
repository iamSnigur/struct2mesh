.sidebar {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 15%;
    background-color: var(--col-sidebar-bg);
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
}

.export-section {
    flex-direction: column;
    padding: 18px 14px;
}

.export-title {
    color: white;
    font-size: 26px;
    -unity-font-definition: var(--font-troika);
    margin-bottom: 18px;
    letter-spacing: 1px;
}

.export-error {
    visibility: hidden;
    color: rgb(250, 60, 0);
    font-size: 20px;
    -unity-font-definition: var(--font-troika);
    letter-spacing: 1px;
}

.btn-export-root {
    width: 100%;
    height: 52px;
    margin-bottom: 30px;
}

.btn-export {
    color: white;
    font-size: 24px;
    -unity-text-align: middle-left;
    padding-left: 20px;
    padding-right: 48px;
}

.btn-export:active {
    font-size: 23px;
}

.btn-load-new-root {
    width: 100%;
    height: 60px;
}

.btn-load-new {
    color: rgb(143, 31, 11);
    font-size: 28px;
    letter-spacing: 2px;
    text-shadow: 0 3px 0 rgb(255, 169, 31);

    -unity-background-image-tint-color: rgb(253, 155, 7);

    -unity-text-align: middle-center;
}

.btn-load-new:active {
    font-size: 27px;
    -unity-background-image-tint-color: rgb(228, 144, 8);
}

.chevron-icon {
    width: 28px;
    height: 28px;
    position: absolute;
    right: 12px;
    top: 50%;
    translate: 0 -50%;
    background-image: url("../Icons/chevron.svg");
    -unity-background-image-tint-color: white;
    -unity-background-scale-mode: scale-to-fit;
}

.bottom-bar {
    position: absolute;
    bottom: 18px;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 10px 14px;
    padding-bottom: 2px;
}

.bottom-bar > * {
    margin-top: 4px;
}

.btn-camera-reset {
    position: absolute;
    width: 60px;
    height: 60px;

    margin: 0;
    bottom: 20px;
    left: -75px;

    background-image: url("../Icons/button_flat_outline.png");
    -unity-background-image-tint-color: white;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
    justify-content: center;
    align-items: center;

    background-color: transparent;
    padding: 0;

    transition-property: scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.btn-camera-reset:hover {
    transition-duration: 0.1s;
    scale: 0.9;
    transition-timing-function: ease-out;
}

.btn-camera-reset:active {
    transition-duration: 0.1s;
    scale: 1.0 0.8;
    transition-timing-function: ease-out;
}

.camera-icon {
    width: 60%;
    height: 60%;
    background-image: url("../Icons/camera_reset.svg");
    -unity-background-image-tint-color: white;
    -unity-background-scale-mode: scale-to-fit;
}