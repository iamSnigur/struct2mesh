.popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(0, 0, 0, 0.7);
    border-color: transparent;

    justify-content: center;
    align-items: center;
}

.popup-overlay-hidden {
    transition-duration: 0.8s;
    transition-timing-function: ease-out-cubic;
    background-color: rgba(0, 0, 0, 0);
}

.popup-overlay-hidden .popup-root{
    transition-duration: 0.5s;
    transition-timing-function: ease-in-back;
    translate: 0 -120%;
}

.popup-overlay-shown {
    transition-duration: 0.8s;
    transition-timing-function: ease-out-cubic;
    background-color: rgba(0, 0, 0, 0.7);
}

.popup-overlay-shown .popup-root {
    transition-duration: 0.8s;
    transition-timing-function: ease-out-back;
    translate: 0 0;
}

.popup-root {
    align-self: center;
    width: 50%;
    height: 80%;

    padding: 10px;

    background-color: transparent;
    background-image: var(--img-btn-flat);
    -unity-background-image-tint-color: rgba(25, 25, 30, 0.99);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.popup-border {
    width: 100%;
    height: 100%;
    background-image: url("../Icons/fancy_border0.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 3px;
    border-color: transparent;
    padding: 15px;
}

.popup-header {
    width: 100%;
    height: 10%;
    padding: 8px;
}

.header-label {
    font-size: 40px;
    color: white;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    -unity-font-definition: var(--font-troika);
}

.popup-body {
    width: 100%;
    height: 80%;
    padding: 16px;
}

.popup-footer {
    width: 100%;
    height: 10%;
    padding: 8px;
}

.welcome-hub-content {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: row;
}

.left-panel {
    flex: 1 1 0;
    flex-direction: column;
}

.sponsor-card {
    flex: 1 1 0;
    padding: 12px;
    margin-bottom: 10px;
    background-image: url("../Icons/fancy_border1.png");
    -unity-background-image-tint-color: rgb(65, 65, 65);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 3px;
    border-color: transparent;
}

.knowledge-base-card {
    padding: 12px;
    flex: 1.2 1 0;
    flex-direction: column;

    background-image: url("../Icons/button.png");
    -unity-background-image-tint-color: rgb(65, 65, 65);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.card-title {
    font-size: 32px;
    color: rgb(245, 195, 56);
    -unity-font-definition: var(--font-troika);
}

.card-label {
    width: 100%;
    font-size: 25px;
    color: white;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    -unity-font-definition: var(--font-segoe-ui);
    white-space: normal;
}

.btn-show-knowledge-base-root {
    width: 90%;
    height: 60px;
    min-height: 60px;
    margin-top: auto;
    margin-bottom: 10px;
    align-self: center;
}

.btn-show-knowledge-base {
    color: white;
    font-size: 24px;
}

.parallax-viewport {
    flex: 1 1 0;
    border-radius: 35px;
    overflow: hidden;
    margin-left: 24px;
}

.parallax-media {
    background-image: url("../Images/parallax-media.jpg");
    -unity-background-scale-mode: scale-and-crop;
    position: absolute;
    left: -40px;
    top: -40px;
    right: -40px;
    bottom: -40px;
}

.welcome-hub-footer-content {
    height: 100%;
    width: 100%;
    flex-direction: row;
    align-items: center;
    align-content: flex-start;
    justify-content: flex-end;
}

.footer-link {
    margin-left: 16px;
    margin-right: 16px;
    -unity-font-definition: var(--font-segoe-ui);
    -unity-font-style: normal;
    font-size: 20px;
    color: white;
}

.footer-link:hover {
    color: rgb(160, 160, 160);
}

.popup-welcome-hub-panel {
    width: 100%;
    height: 100%;
    display: flex;
}

.popup-knowledge-base-panel {
    width: 100%;
    height: 100%;
    display: none;
}

.knowledge-base-body-content {
    width: 100%;
    height: 100%;
    padding: 8px;
    flex-direction: column;
}

.knowledge-base-footer-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
}

.btn-back-root {
    height: 100%;
    width: 150px;
}

.btn-back {
    color: white;
    font-size: 24px;
}

.info-card-base {
    width: 100%;
    height: auto;
    
    padding: 12px 12px 12px 16px;
    margin-bottom: 24px;
    
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0.8);
    overflow: hidden;
}

.info-card-decor {
    position: absolute;
    width: 8px;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rebeccapurple;
}

.info-card-title {
    -unity-font-definition: var(--font-troika);
    -unity-font-style: normal;
    font-size: 26px;
    color: rgb(245, 195, 56);
}

.info-card-text {
    -unity-font-definition: var(--font-segoe-ui);
    font-size: 20px;
    color: white;
    white-space: normal;
}

.info-card-note {
    padding-left: 20px;
    -unity-font-definition: var(--font-segoe-ui);
    font-size: 20px;
    color: gray;
    white-space: normal;
}

.scroll-view-root {
    width: 100%;
    height: 100%;
}