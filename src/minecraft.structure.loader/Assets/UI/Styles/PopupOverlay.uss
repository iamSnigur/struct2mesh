.popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(0, 0, 0, 0.7);
    border-color: transparent;

    justify-content: center;
    align-items: center;
}

.popup-overlay-hidden {
    transition-duration: 0.8s;
    transition-timing-function: ease-out-cubic;
    background-color: rgba(0, 0, 0, 0);
}

.popup-overlay-hidden .popup-root{
    transition-duration: 0.5s;
    transition-timing-function: ease-in-back;
    translate: 0 -120%;
}

.popup-overlay-shown {
    transition-duration: 0.8s;
    transition-timing-function: ease-out-cubic;
    background-color: rgba(0, 0, 0, 0.7);
}

.popup-overlay-shown .popup-root {
    transition-duration: 0.8s;
    transition-timing-function: ease-out-back;
    translate: 0 0;
}

.popup-root {
    align-self: center;
    width: 50%;
    height: 80%;

    padding: 10px;

    background-color: transparent;
    background-image: var(--img-btn-flat);
    -unity-background-image-tint-color: rgba(25, 25, 30, 0.99);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.popup-border {
    width: 100%;
    height: 100%;
    background-image: url("../Icons/fancy_border0.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 3px;
    border-color: transparent;
    padding: 15px;
}

.popup-header {
    width: 100%;
    height: 10%;
    padding: 8px;
}

.header-label {
    font-size: 40px;
    color: white;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    -unity-font-definition: var(--font-troika);
}

.popup-body {
    width: 100%;
    height: 80%;
    padding: 16px;
}

.info-content {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: row;
}

.info-left-panel {
    flex: 1 1 0;
    flex-direction: column;
}

.info-text {
    flex: 1 1 0;
    padding: 12px;
    margin-bottom: 10px;
    background-image: url("../Icons/fancy_border1.png");
    -unity-background-image-tint-color: rgb(65, 65, 65);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 3px;
    border-color: transparent;
}

.info-onboarding {
    padding: 12px;
    flex: 1.2 1 0;
    flex-direction: column;

    background-image: url("../Icons/button.png");
    -unity-background-image-tint-color: rgb(65, 65, 65);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.info-title {
    font-size: 32px;
    color: rgb(245, 195, 56);
    -unity-font-definition: var(--font-troika);
}

.info-onboarding-label {
    white-space: normal;
    font-size: 26px;
    color: rgb(220, 220, 220);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    -unity-font-definition: var(--font-segoe-ui);
}

.btn-info-onboarding-root {
    width: 90%;
    height: 60px;
    min-height: 60px;
    margin-top: auto;
    margin-bottom: 10px;
    align-self: center;
}


.btn-info-onboarding {
    color: white;
    font-size: 24px;
}

.info-promo {
    flex: 1 1 0;
    background-image: url("../Images/Animations/Pool/ezgif-frame-001.jpg");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 35px;
    overflow: hidden;
    margin-left: 24px;
}

.body-label {
    width: 100%;
    font-size: 25px;
    color: white;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    -unity-font-definition: var(--font-segoe-ui);
    white-space: normal;
}

.popup-footer {
    width: 100%;
    height: 10%;
    padding: 8px;
}

.welcome-hub-footer-content {
    height: 100%;
    width: 100%;
    flex-direction: row;
    align-items: center;
    align-content: flex-start;
    justify-content: flex-end;
}

.footer-link {
    margin-left: 16px;
    margin-right: 16px;
    -unity-font-definition: var(--font-segoe-ui);
    -unity-font-style: normal;
    font-size: 20px;
    color: white;
}

.footer-link:hover {
    color: rgb(160, 160, 160);
}

.popup-info-panel {
    width: 100%;
    height: 100%;
    display: flex;
}

.popup-onboarding-panel {
    width: 100%;
    height: 100%;
    display: none;
}

.onboarding-body-content {
    width: 100%;
    height: 100%;
    padding: 8px;
    flex-direction: column;
}

.onboarding-image {
    flex: 8 1 0;
    background-image: url("../Images/Onboarding/1.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 16px;
    background-color: rgba(255, 255, 255, 0.05);
}

.onboarding-title {
    flex: 1 1 0;
    -unity-font-definition: var(--font-troika);
    -unity-font-style: normal;
    font-size: 26px;
    color: rgb(245, 195, 56);
}

.onboarding-text {
    flex: 1 1 0;
    -unity-font-definition: var(--font-segoe-ui);
    font-size: 20px;
    color: white;
    white-space: normal;
}

.onboarding-footer-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
}

.btn-back-root {
    height: 100%;
    width: 150px;
}

.btn-back {
    color: white;
    font-size: 24px;
}

.control-panel {
    flex-direction: row;
    align-items: center;
    align-self: flex-end;
    height: 100%;
    width: 40%;
    margin-left: auto;
}

.btn-arrow-root {
    flex: 1 1 0;
    align-items: center;

    height: 100%;
    width: 80px;

    background-color: transparent;
    background-image: url("../Icons/button_flat.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;

    transition-property: scale;
    transition-duration: 0.08s;
    transition-timing-function: ease;
    scale: 1 1;
}

.btn-arrow-root:hover {
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.08s;
    scale: 1.15 1.15;
}

.btn-arrow-root:active {
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.03s;
    scale: 1.05 1.05;
}

.btn-arrow-root:disabled {
    opacity: 0.4;
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.03s;
    scale: 0.95 0.95;
}

.btn-arrow-right {
    top: 50%;
    translate: -3px -50%;
    width: 35px;
    height: 35px;
    background-image: url("../Icons/arrow.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(65, 65, 65);
}

.btn-arrow-left {
    top: 50%;
    translate: 0 -50%;
    width: 35px;
    height: 35px;
    rotate: 180deg;
    background-image: url("../Icons/arrow.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(65, 65, 65);
}

.slide-progress-label {
    flex: 2 1 0;
    -unity-text-align: middle-center;
    color: white;
    font-size: 32px;
    letter-spacing: 4px;
    -unity-font-definition: var(--font-troika);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
    background-color: transparent;
}