.loader-root {
    position: absolute;
    display: none;

    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);

    align-items: center;
    justify-content: center;
}

.loader-icon {
    height: 96px;
    width: 96px;

    background-image: url("../Icons/pickaxe_outline.png");
    -unity-background-scale-mode: scale-to-fit;

    align-self: center;
    margin-bottom: 10px;
}

.loader-label {
    align-self: center;
    color: rgba(255, 255, 255, 1);
    -unity-font-definition: var(--font-troika);
    font-size: 28px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
}