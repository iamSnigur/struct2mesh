%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40f8dc961c154e759d4406c2958d3cbc, type: 3}
  m_Name: OnboardingSlidesConfig
  m_EditorClassIdentifier: StructureLoader::Core.UI.OnboardingSlidesConfig
  Slides:
  - Title: "Step 1 \u2014 Get a Structure Block"
    Image: {fileID: 21300000, guid: d4215d85f1e0efc409bd732016f71833, type: 3}
    Description: Open chat and run <color=#fff021>/give @p minecraft:structure_block</color>.
      This is the one way to obtain it, since it isn't in the creative inventory
      by default.
  - Title: "Step 2 \u2014 Place the Structure Block"
    Image: {fileID: 21300000, guid: e3941f37bfb1d4d41ba120dc57f1a78c, type: 3}
    Description: "Place it adjacent to or near the structure you want to save. Position
      doesn't matter much \u2014 you'll define the area in a later step."
  - Title: "Step 3 \u2014 Open the Structure Block UI"
    Image: {fileID: 21300000, guid: cbda902a77fbe234ab765c96ffd779e3, type: 3}
    Description: Right-click the block to bring up its menu, showing fields for name,
      position, size, and mode.
  - Title: "Step 4 \u2014 Switch to Save Mode"
    Image: {fileID: 21300000, guid: 1ee8ea9fb8de379448114e95898e8803, type: 3}
    Description: Click the <b>Load</b> mode button until it shows the <b>Save</b>
      icon and text.
  - Title: "Step 5 \u2014 Name the Structure"
    Image: {fileID: 21300000, guid: 731f3f4414adb99469c61c17abdeaf7c, type: 3}
    Description: Type a name like <color=#fff021>mystructure</color> into the <b>Structure
      Name</b> field. This becomes the filename.
  - Title: "Step 6 \u2014 Define the Save Area"
    Image: {fileID: 21300000, guid: 8db0ba74a9e03504cb48b012c29603b1, type: 3}
    Description: Use the <b>Relative Position</b> and <b>Structure Size</b> fields
      to position the white boundary box around the area you want to capture.
  - Title: "Step 7 \u2014 Save"
    Image: {fileID: 21300000, guid: b7bb8fbfa200f0e4db5821e1b4596147, type: 3}
    Description: Click the <b>Save</b> button. A successful save shows a message
      in the chat.
  - Title: "Step 8 \u2014 Locate the File"
    Image: {fileID: 21300000, guid: 658676e85b152a745a05c0974d217703, type: 3}
    Description: 'Locate your .minecraft folder and navigate to: <world folder>/generated/minecraft/structures/mystructure.nbt'
