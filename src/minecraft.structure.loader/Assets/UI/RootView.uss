:root {
    --col-sidebar-bg:       rgba(0, 0, 0, 0.5);
    --col-export-btn:       rgb(82, 175, 45);
    --col-export-hover:     rgb(82, 175, 45);
    --col-export-active:    rgb(50, 120, 25);
    --col-load-btn:         rgb(253 155 7);
    --col-camera-bg:        rgb(220, 220, 220);
    --col-camera-hover:     rgb(255, 255, 255);
    --col-text-bright:      rgb(255, 255, 255);
    --col-text-label:       rgb(255, 255, 255);
    --col-chevron:          rgb(255, 255, 255);

    --sidebar-width:        220px;
    --btn-height:           52px;
    --btn-outline-height:   56px;
    --btn-margin:           8px;
    --panel-padding:        14px;

    --font-troika:          url("Fonts/troika.otf");
    --font-consolas:        url("Fonts/Consolas-Regular.ttf");
    --font-segoe-ui:        url("Fonts/Segoe UI.ttf");
    
    --img-btn:              url("Icons/button.png");
    --img-btn-flat:         url("Icons/button_flat.png");
}

.root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.file-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    color: var(--col-text-label);
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-definition: var(--font-troika);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
}

.sidebar {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 15%;
    background-color: var(--col-sidebar-bg);
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
}

.export-section {
    flex-direction: column;
    padding: 18px var(--panel-padding);
}

.export-title {
    color: var(--col-text-label);
    font-size: 26px;
    -unity-font-definition: var(--font-troika);
    margin-bottom: 18px;
    letter-spacing: 1px;
}

.btn-export-root {
    width: 100%;
    height: 52px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 30px;
}

.btn-load-new-root {
    width: 100%;
    height: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.btn-outline {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    
    background-color: transparent;
    background-image: var(--img-btn-flat);
    -unity-background-image-tint-color: rgb(0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
}

.btn-export {
    height: 100%;
    width: 100%;
    position: absolute;
    
    color: var(--col-text-bright);
    font-size: 24px;
    -unity-font-definition: var(--font-troika);
    letter-spacing: 2px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
    background-color: transparent;

    background-image: var(--img-btn);
    -unity-background-image-tint-color: var(--col-export-btn);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
    
    -unity-text-align: middle-left;
    padding-left: 20px;
    padding-right: 48px;
}

.btn-export-root:hover .btn-outline {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.btn-load-new {
    height: 100%;
    width: 100%;
    background-color: transparent;

    color: rgb(143, 31, 11);
    font-size: 28px;
    -unity-font-definition: var(--font-troika);
    letter-spacing: 2px;
    text-shadow: 0 3px 0 rgb(255, 169, 31);

    background-image: var(--img-btn);
    -unity-background-image-tint-color: var(--col-load-btn);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;

    -unity-text-align: middle-center;
}

.btn-load-new-root:hover .btn-outline {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.chevron-icon {
    width: 28px;
    height: 28px;
    position: absolute;
    right: 12px;
    top: 50%;
    translate: 0 -50%;
    background-image: url("Icons/chevron.svg");
    -unity-background-image-tint-color: var(--col-chevron);
    -unity-background-scale-mode: scale-to-fit;    
}

.bottom-bar {
    position: absolute;
    bottom: 18px;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 10px var(--panel-padding);
    padding-bottom: 2px;
}

.bottom-bar > * {
    margin-top: 4px;
}

.btn-camera-reset {
    position: absolute;
    width: 60px;
    height: 60px;
    
    margin: 0;
    bottom: 20px;
    left: -75px;

    background-image: url("Icons/button_flat_outline.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: stretch-to-fill;   
    -unity-slice-scale: 5px;
    border-color: transparent;
    justify-content: center;
    align-items: center;
    
    background-color: transparent;
    padding: 0;

    transition-property: scale;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
    scale: 1 1;
}

.btn-camera-reset:hover {
    scale: 0.93 0.93;       
}

.btn-camera-reset:active {
    transition-duration: 0.05s;
    scale: 1.08 0.82;
}

.camera-icon {
    width: 60%;
    height: 60%;
    background-image: url("Icons/camera_reset.svg");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;    
}

.version-label {
    position: absolute;
    bottom: 0;
    left: 4px;
    color: rgba(255, 255, 255, 0.3);
    -unity-font-definition: var(--font-consolas);
    font-size: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    align-self: flex-start;
}

.loader {
    position: absolute;
    display: none;
    
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    
    align-items: center;
    justify-content: center;
}

.loader-icon {
    height: 96px;
    width: 96px;

    background-image: url("Icons/pickaxe_outline.png");
    -unity-background-scale-mode: scale-to-fit;
    
    align-self: center;
    margin-bottom: 10px;
}

.loader-label {
    align-self: center;
    color: rgba(255, 255, 255, 1);
    -unity-font-definition: var(--font-troika);
    font-size: 28px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
}

.disclaimer-root {
    display: none;
    width: 450px;
    height: 180px;
    margin-top: 20px;
    padding: 8px 10px;
    top: 0;
    position: absolute;
    align-self: center;

    background-image: var(--img-btn-flat);
    -unity-background-image-tint-color: rgba(60, 60, 60, 1);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.disclaimer-label {
    flex-grow: 1;
    
    color: rgba(255, 255, 255, 1);
    font-size: 13px;
    letter-spacing: 3px;
    -unity-font-definition: var(--font-segoe-ui);
    -unity-text-align: upper-left;
    
    white-space: normal;
    overflow: hidden;
    text-overflow: clip;
}

.btn-ok {
    margin-bottom: 10px;
    align-self: center;
    width: 25%;
    height: 40px;
    color: rgba(60, 60, 60, 1);
    font-size: 22px;
    -unity-font-definition: var(--font-troika);
    letter-spacing: 2px;
    background-color: transparent;

    background-image: var(--img-btn-flat);
    -unity-background-image-tint-color: white;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;

    transition-property: scale;
    transition-duration: 0.08s;
    transition-timing-function: ease;
    scale: 1 1;
}

.btn-ok:hover {
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.08s;
    scale: 1.15 1.15;
}

.btn-ok:active {
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.03s;
    scale: 1.05 1.05;
}

.popup-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    
    background-color: rgba(0, 0, 0, 0.7);
    border-color: transparent;

    justify-content: center;
    align-items: center;
}

.popup-root {
    align-self: center;
    width: 50%;
    height: 80%;
    background-color: transparent;

    padding: 10px;
    
    background-image: var(--img-btn-flat);
    -unity-background-image-tint-color: rgba(25, 25, 30, 0.99);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.popup-border {
    width: 100%;
    height: 100%;
    background-image: url("Icons/fancy_border0.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
    padding: 15px;
}

.popup-header {
    width: 100%;
    height: 10%;
    padding: 8px;
}

.header-label {
    font-size: 40px;
    color: white;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    -unity-font-definition: var(--font-troika);
}

.popup-body {
    width: 100%;
    height: 80%;
    padding: 16px;
}

.info-content {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: row;
}

.info-left-panel {
    flex: 1 1 0;
    flex-direction: column;
}

.info-text {
    flex: 1 1 0;
    padding: 12px;
    margin-bottom: 10px;
    background-image: url("Icons/fancy_border1.png");
    -unity-background-image-tint-color: rgb(65, 65, 65);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.info-onboarding {
    padding: 12px;
    flex: 1 1 0;
    flex-direction: column;
    
    background-image: url("Icons/button.png");
    -unity-background-image-tint-color: rgb(65, 65, 65);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
}

.info-title {
    font-size: 32px;
    color: rgb(245, 195, 56);
    -unity-font-definition: var(--font-troika);
}

.info-onboarding-label {
    white-space: normal;
    font-size: 26px;
    color: rgb(220, 220, 220);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
    -unity-font-definition: var(--font-segoe-ui);
}

.btn-info-onboarding-root {
    width: 90%;
    height: 60px;
    min-height: 30px;
    margin-top: auto;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.btn-info-onboarding-root:hover .btn-outline {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.btn-info-onboarding {
    color: var(--col-text-bright);
    font-size: 24px;
    -unity-font-definition: var(--font-troika);
    letter-spacing: 2px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
    background-color: transparent;

    background-image: var(--img-btn);
    -unity-background-image-tint-color: var(--col-export-btn);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;
    
    width: 100%;
    height: 100%;
}

.info-promo {
    flex: 1 1 0;
    background-image: url("Images/Animations/Pool/ezgif-frame-001.jpg");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 35px;
    overflow: hidden;
    margin-left: 24px;
}

.body-label {
    width: 100%;
    font-size: 25px;
    color: white;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);    
    -unity-font-definition: var(--font-segoe-ui);
    white-space: normal;
}

.popup-footer {
    width: 100%;
    height: 10%;
    padding: 8px;
}

.popup-info-panel {
    width: 100%;
    height: 100%;
    display: flex;
}

.popup-onboarding-panel {
    width: 100%;
    height: 100%;
    display: none;
}

.onboarding-body-content {
    width: 100%;
    height: 100%;
    padding: 8px;
    flex-direction: column;
}

.onboarding-image {
    flex: 8 1 0;
    background-image: url("Images/Onboarding/2025-11-04_11.51.29.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 16px;
    background-color: rgba(255, 255, 255, 0.05);
}

.onboarding-title {
    flex: 1 1 0;
    -unity-font-definition: var(--font-troika);
    -unity-font-style: normal;
    font-size: 26px;
    color: rgb(245, 195, 56);
}

.onboarding-text {
    flex: 1 1 0;
    -unity-font-definition: var(--font-segoe-ui);
    font-size: 20px;
    color: white;
    white-space: normal;
}

.inline-text {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    -unity-font-definition: var(--font-segoe-ui);
    font-size: 20px;
    color: white;
    white-space: normal;
}

.inline-code {
    white-space: normal;
    -unity-font-definition: var(--font-consolas);
    font-size: 18px;
    color: orange;
    background-color: rgba(255,255,255,0.08);
    border-color: rgb(165,165,165);
    border-width: 1px;
    border-radius: 10px;
    padding-left: 4px;
    padding-right: 4px;
}

.onboarding-footer-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
}

.btn-back-root {    
    height: 100%;
    width: 150px;
    justify-content: center;
    align-items: center;
}

.btn-back-root:hover .btn-outline {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.btn-back {
    width: 100%;
    height: 100%;
    
    color: var(--col-text-bright);
    font-size: 24px;
    -unity-font-definition: var(--font-troika);
    letter-spacing: 2px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
    background-color: transparent;

    background-image: var(--img-btn);
    -unity-background-image-tint-color: var(--col-export-btn);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;    
}

.control-panel {
    flex-direction: row;
    align-items: center;
    align-self: flex-end;
    height: 100%;
    width: 40%;
    margin-left: auto;
}

.btn-arrow-root {
    flex: 1 1 0;
    align-items: center;
    
    height: 100%;
    width: 80px;

    background-color: transparent;
    background-image: url("Icons/button_flat.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-scale: 5px;
    border-color: transparent;

    transition-property: scale;
    transition-duration: 0.08s;
    transition-timing-function: ease;
    scale: 1 1;
}

.btn-arrow-root:hover {
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.08s;
    scale: 1.15 1.15;
}

.btn-arrow-root:active {
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.03s;
    scale: 1.05 1.05;
}

.btn-arrow-root:disabled {
    opacity: 0.4;
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.03s;
    scale: 0.95 0.95;
}

.btn-arrow-right {
    top: 50%;
    translate: -3px -50%;
    width: 35px;
    height: 35px;
    background-image: url("Icons/arrow.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(65, 65, 65);
}

.btn-arrow-left {
    top: 50%;
    translate: 0 -50%;
    width: 35px;
    height: 35px;
    rotate: 180deg;
    background-image: url("Icons/arrow.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(65, 65, 65);
}

.slide-progress-label {
    flex: 2 1 0;
    -unity-text-align: middle-center;
    color: var(--col-text-bright);
    font-size: 32px;
    letter-spacing: 4px;
    -unity-font-definition: var(--font-troika);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
    background-color: transparent;
}
