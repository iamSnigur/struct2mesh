<ui:UXML 
    xmlns:ui="UnityEngine.UIElements" 
    noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">
    
    <Style src="RootView.uss"/>
    <ui:Template name="sidebar" src="Uxml/Sidebar.uxml"/>
    <ui:Template name="disclaimer" src="Uxml/Disclaimer.uxml"/>
    <ui:Template name="popup-overlay" src="Uxml/PopupOverlay.uxml"/>
    <ui:Template name="loading-curtain" src="Uxml/LoadingCurtain.uxml"/>
    
    <ui:VisualElement name="root" class="root">
        <ui:Label name="version-label" text="v1.0.1-dev-e128f56" class="version-label"/>
        <ui:Label name="file-label" text="STRUCTURE.NBT" class="file-label"/>
        <ui:Button name="btn-welcome-hub" class="btn-welcome-hub" text="Welcome!">
            <ui:VisualElement class="creeper-face"/>
        </ui:Button>

        <ui:Instance template="sidebar" name="sidebar" class="sidebar"/>
        <ui:Instance template="disclaimer" name="disclaimer-root" class="disclaimer-root disclaimer-hidden"/>
        <ui:Instance template="popup-overlay" name="popup-overlay" class="popup-overlay popup-overlay-hidden"/>
        
        <ui:Instance template="loading-curtain" name="loader" class="loader"/>
    </ui:VisualElement>
</ui:UXML>
